# Local/test defaults. Production secrets live only in /etc/roto-kb/roto-kb.env.
# Optional local secret file shared with a client repository. Explicit process
# environment variables still take precedence. Keep this file outside Git.
# ROTO_KB_ENV_FILE=E:\\Project\\ROTO\\.env.kb-local
ROTO_KB_MODE=empty
ROTO_KB_HOST=127.0.0.1
ROTO_KB_PORT=8710
ROTO_KB_SOURCE_PATH=knowledge
ROTO_KB_DATA_PATH=.roto-kb
# Default: local embedded Qdrant (no Docker). Use QDRANT_MODE=server only with compose.
QDRANT_URL=http://127.0.0.1:6334
QDRANT_MODE=embedded
QDRANT_PATH=.roto-kb/qdrant
QDRANT_API_KEY=
# Skip embedding multi-MB ontology dumps; keep stubs for browse.
ROTO_KB_MAX_INDEX_CHARS=200000
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=do-not-commit
DASHSCOPE_LLM_MODEL=qwen3.7-flash
LLM_ENABLED=false
LLM_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSION=provided-by-capability-probe
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=30
# ROTO_KB_READ_TOKEN=at-least-32-random-bytes
# ROTO_KB_ADMIN_TOKEN=at-least-32-different-random-bytes

# Copy to /etc/roto-kb/roto-kb.env on the server. Do not commit real secrets.
ROTO_KB_MODE=production
ROTO_KB_HOST=127.0.0.1
ROTO_KB_PORT=8710
ROTO_KB_SOURCE_PATH=/data/roto-kb/sources
ROTO_KB_DATA_PATH=/data/roto-kb/index

# Embedded local Qdrant (no Docker / no public port).
QDRANT_MODE=embedded
QDRANT_PATH=/data/roto-kb/index/qdrant
QDRANT_URL=http://127.0.0.1:6334
QDRANT_API_KEY=

DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_LLM_MODEL=qwen3.7-flash
LLM_ENABLED=false
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_SECONDS=30

ROTO_KB_READ_TOKEN=replace-with-32plus-random-bytes
ROTO_KB_ADMIN_TOKEN=replace-with-different-32plus-random-bytes

[Unit]
Description=ROTO-KB engineering knowledge RAG service
After=network.target

[Service]
Type=simple
User=@ROTO_KB_SERVICE_USER@
Group=@ROTO_KB_SERVICE_GROUP@
WorkingDirectory=@ROTO_KB_APP_ROOT@
EnvironmentFile=/etc/roto-kb/roto-kb.env
ExecStart=@ROTO_KB_APP_ROOT@/.venv/bin/python -m roto_kb serve --host 127.0.0.1 --port 8710
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=@ROTO_KB_DATA_ROOT@ /var/log/roto-kb @ROTO_KB_APP_ROOT@
StandardOutput=append:/var/log/roto-kb/roto-kb.log
StandardError=append:/var/log/roto-kb/roto-kb.err.log

[Install]
WantedBy=multi-user.target
